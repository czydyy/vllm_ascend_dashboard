# Public deployments use / by default. Keep local proxy overrides in .env.local.
# VITE_APP_BASE_PATH=/dev

# Keep browser requests same-origin and let Vite proxy /api to the selected backend.
# Use the backend origin only; do not append /api/v1.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000

# Set to false only when the intranet backend uses a self-signed certificate.
# VITE_API_PROXY_SECURE=false
