# GitHub 启动兜底配置（运行时配置由系统配置页面写入 MySQL）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=vllm-project
GITHUB_REPO=vllm-ascend

# 数据库配置（开发和生产均使用 MySQL）
DATABASE_URL=mysql+aiomysql://dashboard:change-me@localhost:3306/vllm_dashboard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=60
MYSQL_DATABASE=vllm_dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用配置
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# 数据文件存储目录，默认为根目录 data/
DATA_DIR=data

# CI、模型同步、缓存、日报和 SMTP 等运行时业务配置存储在 MySQL，
# 通过系统配置页面管理，不在 .env 中维护。

# LLM API Keys（用于 AI 总结生成）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:8000/api/v1
