# Local development only. Copy to .env.local; never use these values in production.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_DATABASE=vllm_dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-random-local-jwt-secret
LITELLM_MASTER_KEY=replace-with-a-random-local-litellm-key
GITHUB_TOKEN=
GITHUB_OWNER=vllm-project
GITHUB_REPO=vllm-ascend
DEV_MYSQL_PORT=3308
DEV_BACKEND_PORT=8000
DEV_FRONTEND_PORT=3000
