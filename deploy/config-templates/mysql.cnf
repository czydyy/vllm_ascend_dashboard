# Custom MySQL Configuration for Production
# Mount this file to: /etc/mysql/conf.d/custom.cnf
#
# Phase 0 前：binlog 注释，innodb_flush_log_at_trx_commit=2
# Phase 0 后：binlog + GTID 开启，sync_binlog=1，innodb_flush_log_at_trx_commit=1

[mysqld]
# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Connection Settings
max_connections = 200
max_allowed_packet = 64M
wait_timeout = 28800
interactive_timeout = 28800

# ============================================================
# Fix "Out of sort memory" error
# ============================================================
sort_buffer_size = 4M
group_concat_max_len = 1048576
tmp_table_size = 64M
max_heap_table_size = 64M

# InnoDB Settings
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
# Phase 0 改为 1：每次事务提交都刷盘，单机崩溃 RPO=0
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# Logging
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# ============================================================
# Binary Logging（Phase 0 开启）
# ============================================================
server_id = 1
log_bin = /var/log/mysql/mysql-bin
binlog_format = ROW
sync_binlog = 1

# GTID（Phase 0 开启，简化副本配置和主备切换）
gtid_mode = ON
enforce_gtid_consistency = ON

# Binlog 保留与副本提升准备
# 2026-08-14 事故：7 天保留 + commit 卡死（GTID 下未提交事务阻止 purge 推进）
# 导致 binlog 堆积到 131G 撑爆根盘，进而 fsync 失败、整个 commit pipeline 停摆。
# 缩短到 2 天，使正常积累（约 30G/天）远低于根盘可用空间；如副本启用再酌情调大。
# 治本建议：binlog 当前 bind-mount 在根盘 /data/mysql/binlog，应迁到独立卷。
binlog_expire_logs_seconds = 172800   # 2 天
log_replica_updates = ON              # 副本可能被提升为主库

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
